BOT_TOKEN=
ADMIN_IDS=
DATABASE_URL=sqlite+aiosqlite:///data_runtime/bot.db

# Баллы: 1 балл = 1 рубль
PRICE_YES_NO=30
PRICE_ENERGY=199
PRICE_MONEY=199
START_BALANCE=0

# Telegram Stars
ENABLE_STARS=true
RUB_TO_STARS=1

# YooKassa (рубли)
ENABLE_YOOKASSA=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_URL=https://t.me/

# Пакеты баллов для покупки: количество=цена_в_рублях
# По умолчанию 1:1
BALANCE_PACKS=30:30,50:50,100:100,200:200,500:500

# Часовой пояс для карты дня и напоминаний
TZ=Europe/Moscow
MORNING_REMINDER_HOUR=10
